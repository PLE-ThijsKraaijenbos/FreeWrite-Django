SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:8081
CSRF_TRUSTED_ORIGINS=http://localhost:8081

# ngrok tunnel (runs as a docker service) for reaching the local API from a physical device.
# additionally helps to avoid expo/firewall issues on the frontend when developing.
NGROK_AUTHTOKEN=your-ngrok-authtoken
NGROK_DOMAIN=your-subdomain.ngrok-free.app

DATABASE_URL=postgresql://freewrite:freewrite@postgres:5432/freewrite

CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
